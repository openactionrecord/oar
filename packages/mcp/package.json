{
  "name": "@openactionrecord/mcp",
  "version": "0.1.0",
  "description": "Record every tool call of an MCP server as Open Action Records, with your rules checked before the tool runs.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20.12" },
  "keywords": ["ai-agents", "mcp", "model-context-protocol", "audit", "receipts", "middleware", "open-action-record", "oar"],
  "repository": { "type": "git", "url": "git+https://github.com/openactionrecord/oar.git", "directory": "packages/mcp" },
  "homepage": "https://github.com/openactionrecord/oar#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openactionrecord/core": "workspace:^"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^3.25.76"
  }
}
