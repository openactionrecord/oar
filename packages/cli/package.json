{
  "name": "@openactionrecord/cli",
  "version": "0.2.0",
  "description": "oar: verify Open Action Records from the command line, and see a 60-second demo of what they prove.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "oar": "./dist/main.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "keywords": [
    "ai-agents",
    "audit",
    "receipts",
    "verify",
    "cli",
    "open-action-record",
    "oar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openactionrecord/oar.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/openactionrecord/oar#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@openactionrecord/core": "workspace:^"
  }
}
